{
  "$ref": "#/definitions/dossier",
  "definitions": {
    "dossier": {
      "type": "object",
      "properties": {
        "candidate_id": {
          "type": "string"
        },
        "race_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "party": {
          "type": "string",
          "enum": [
            "DEM",
            "REP",
            "LIB",
            "GRE",
            "IND",
            "CON",
            "OTH"
          ]
        },
        "incumbent": {
          "type": "boolean"
        },
        "role": {
          "type": "string",
          "enum": [
            "incumbent",
            "challenger"
          ]
        },
        "bioguide_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "generated_at": {
          "type": "string"
        },
        "data_status": {
          "type": "string",
          "enum": [
            "real",
            "mock",
            "partial"
          ]
        },
        "summary": {
          "type": "string"
        },
        "summary_needs_review": {
          "type": "boolean"
        },
        "evidence_basis": {
          "type": "string",
          "enum": [
            "record",
            "statements",
            "mixed"
          ]
        },
        "asymmetry_note": {
          "type": "string"
        },
        "stances": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "issue_id": {
                "type": "string",
                "enum": [
                  "healthcare",
                  "energy_climate",
                  "defense",
                  "crypto_fintech",
                  "immigration",
                  "abortion",
                  "guns",
                  "tax_budget",
                  "tech_ai",
                  "labor_trade"
                ]
              },
              "position": {
                "type": "string"
              },
              "direction": {
                "type": "integer",
                "minimum": -2,
                "maximum": 2
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              "needs_review": {
                "type": "boolean"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "roll_call_vote",
                        "sponsored_bill",
                        "cosponsored_bill",
                        "stated_position",
                        "curated_statement"
                      ]
                    },
                    "title": {
                      "type": "string"
                    },
                    "description": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "date": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "vote": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "Yea",
                            "Nay",
                            "Not Voting",
                            "Present"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "bill_id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "congress": {
                      "anyOf": [
                        {
                          "type": "integer"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "roll_number": {
                      "anyOf": [
                        {
                          "type": "integer"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "source_label": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "title",
                    "description",
                    "date",
                    "vote",
                    "bill_id",
                    "congress",
                    "roll_number",
                    "url",
                    "source_label"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "issue_id",
              "position",
              "confidence",
              "needs_review",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        "enrichment": {
          "type": "object",
          "properties": {
            "stances": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "issue_id": {
                    "type": "string",
                    "enum": [
                      "healthcare",
                      "energy_climate",
                      "defense",
                      "crypto_fintech",
                      "immigration",
                      "abortion",
                      "guns",
                      "tax_budget",
                      "tech_ai",
                      "labor_trade"
                    ]
                  },
                  "summary": {
                    "type": "string",
                    "maxLength": 800
                  },
                  "direction_proposed": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -2,
                        "maximum": 2
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "confidence": {
                    "type": "string",
                    "enum": [
                      "high",
                      "medium",
                      "low"
                    ]
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "url": {
                          "type": "string",
                          "format": "uri"
                        },
                        "publisher": {
                          "type": "string"
                        },
                        "published_on": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "excerpt": {
                          "type": "string",
                          "maxLength": 400
                        },
                        "excerpt_verified": {
                          "type": "boolean"
                        },
                        "wayback_url": {
                          "type": "string",
                          "format": "uri"
                        }
                      },
                      "required": [
                        "url",
                        "publisher",
                        "published_on",
                        "excerpt",
                        "excerpt_verified"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1
                  },
                  "posts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "url": {
                          "type": "string",
                          "format": "uri"
                        },
                        "excerpt": {
                          "type": "string",
                          "maxLength": 400
                        },
                        "posted_on": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "url",
                        "excerpt",
                        "posted_on"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "provenance": {
                    "type": "object",
                    "properties": {
                      "tagged_by": {
                        "type": "string"
                      },
                      "tagged_at": {
                        "type": "string"
                      },
                      "model": {
                        "type": "string"
                      },
                      "prompt_version": {
                        "type": "string"
                      },
                      "tools": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "web_search",
                            "x_search"
                          ]
                        }
                      },
                      "tool_filters": {
                        "type": "object",
                        "additionalProperties": {}
                      },
                      "response_id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "retrieved_at": {
                        "type": "string"
                      },
                      "citations": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uri"
                        }
                      },
                      "confidence": {
                        "type": "string",
                        "enum": [
                          "high",
                          "medium",
                          "low"
                        ]
                      },
                      "review_status": {
                        "type": "string",
                        "enum": [
                          "pending",
                          "accepted",
                          "rejected"
                        ]
                      },
                      "reviewed_by": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "reviewed_at": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "review_note": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "tagged_by",
                      "tagged_at",
                      "model",
                      "prompt_version",
                      "tools",
                      "tool_filters",
                      "response_id",
                      "retrieved_at",
                      "citations",
                      "confidence",
                      "review_status",
                      "reviewed_by",
                      "reviewed_at",
                      "review_note"
                    ],
                    "additionalProperties": false
                  },
                  "basis": {
                    "type": "string",
                    "enum": [
                      "inferred",
                      "verified"
                    ]
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "issue_id",
                  "summary",
                  "direction_proposed",
                  "confidence",
                  "sources",
                  "posts",
                  "provenance",
                  "basis",
                  "label"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "stances"
          ],
          "additionalProperties": false
        },
        "links": {
          "type": "object",
          "properties": {
            "fec_url": {
              "type": "string",
              "format": "uri"
            },
            "congress_url": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri"
                },
                {
                  "type": "null"
                }
              ]
            },
            "campaign_site": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "fec_url",
            "congress_url",
            "campaign_site"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "candidate_id",
        "race_id",
        "name",
        "party",
        "incumbent",
        "role",
        "bioguide_id",
        "generated_at",
        "data_status",
        "summary",
        "summary_needs_review",
        "evidence_basis",
        "asymmetry_note",
        "stances",
        "links"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}