          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "individual",
            "organization"
          ]
        },
        "race_id": {
          "type": "string"
        },
        "generated_at": {
          "type": "string"
        },
        "data_status": {
          "type": "string",
          "enum": [
            "real",
            "mock",
            "partial"
          ]
        },
        "total_given": {
          "type": "number"
        },
        "total_in_chains": {
          "type": "number"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "individual",
                  "organization",
                  "committee",
                  "candidate"
                ]
              },
              "committee_type": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "H",
                      "S",
                      "P",
                      "X",
                      "Y",
                      "Z",
                      "N",
                      "Q",
                      "O",
                      "U",
                      "V",
                      "W",
                      "D",
                      "E",
                      "I",
                      "C"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "depth": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "amount": {
                "type": "number"
              },
              "is_spender": {
                "type": "boolean"
              },
              "has_chain": {
                "type": "boolean"
              },
              "source_url": {
                "type": "string",
