      "required": [
        "donor_id",
        "donor_key",
        "name",
        "kind",
        "race_id",
        "generated_at",
        "data_status",
        "total_given",
        "total_in_chains",
        "nodes",
        "edges",
        "allocation_note",
        "truncated",
        "method"
      ],
      "additionalProperties": false
