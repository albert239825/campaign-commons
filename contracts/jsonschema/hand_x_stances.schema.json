{
  "$ref": "#/definitions/hand_x_stances",
  "definitions": {
    "hand_x_stances": {
      "type": "object",
      "properties": {
        "race_id": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "candidate_id": {
                "type": "string"
              },
              "issue_id": {
                "type": "string",
                "enum": [
                  "healthcare",
                  "energy_climate",
                  "defense",
                  "crypto_fintech",
                  "immigration",
                  "abortion",
                  "guns",
                  "tax_budget",
                  "tech_ai",
                  "labor_trade"
                ]
              },
              "summary": {
                "type": "string",
                "maxLength": 600
              },
              "direction_proposed": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -2,
                    "maximum": 2
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "publisher": {
                      "type": "string"
                    },
                    "published_on": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "excerpt": {
                      "type": "string",
                      "maxLength": 400
                    },
                    "excerpt_verified": {
                      "type": "boolean"
                    },
                    "wayback_url": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": [
                    "url",
                    "publisher",
                    "published_on",
                    "excerpt",
                    "excerpt_verified"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "posts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "excerpt": {
                      "type": "string",
                      "maxLength": 400
                    },
                    "posted_on": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "url",
                    "excerpt",
                    "posted_on"
                  ],
                  "additionalProperties": false
                }
              },
              "provenance": {
                "type": "object",
                "properties": {
                  "tagged_by": {
                    "type": "string"
                  },
                  "tagged_at": {
                    "type": "string"
                  },
                  "model": {
                    "type": "string"
                  },
                  "prompt_version": {
                    "type": "string"
                  },
                  "tools": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "web_search",
                        "x_search"
                      ]
                    }
                  },
                  "tool_filters": {
                    "type": "object",
                    "additionalProperties": {}
                  },
                  "response_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "retrieved_at": {
                    "type": "string"
                  },
                  "citations": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "confidence": {
                    "type": "string",
                    "enum": [
                      "high",
                      "medium",
                      "low"
                    ]
                  },
                  "review_status": {
                    "type": "string",
                    "enum": [
                      "pending",
                      "accepted",
                      "rejected"
                    ]
                  },
                  "reviewed_by": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "reviewed_at": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "review_note": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "tagged_by",
                  "tagged_at",
                  "model",
                  "prompt_version",
                  "tools",
                  "tool_filters",
                  "response_id",
                  "retrieved_at",
                  "citations",
                  "confidence",
                  "review_status",
                  "reviewed_by",
                  "reviewed_at",
                  "review_note"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "candidate_id",
              "issue_id",
              "summary",
              "direction_proposed",
              "confidence",
              "sources",
              "posts",
              "provenance"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "race_id",
        "method",
        "rows"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}