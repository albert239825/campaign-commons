                    "type": "null"
                  }
                ]
              },
              "basis": {
                "type": "object",
                "properties": {
                  "basis": {
                    "type": "string",
                    "enum": [
                      "filed",
                      "verified",
                      "inferred",
                      "adjacent"
                    ]
                  },
                  "rule": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_urls": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "checked_by": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "checked_at": {
