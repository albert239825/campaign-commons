              "committee_type": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "H",
                      "S",
                      "P",
                      "X",
                      "Y",
                      "Z",
                      "N",
                      "Q",
                      "O",
                      "U",
                      "V",
                      "W",
                      "D",
                      "E",
                      "I",
                      "C"
