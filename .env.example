# Copy to .env (gitignored). Both keys are free and instant.
FEC_API_KEY=            # https://api.open.fec.gov/developers/
CONGRESS_GOV_API_KEY=   # https://api.congress.gov/sign-up/

# Money Trails question routing (D-75) — optional, server-side only (web/src/lib/ask-llm.ts). Without a key the ask box still
# answers through the deterministic resolver; with one, Grok picks the (intent, subject) route from the closed set first.
XAI_API_KEY=            # https://console.x.ai/ — paid; ~2.6k prompt tokens per ask (see docs/LOG.md)
XAI_MODEL=              # optional; defaults to grok-4.5 (must support structured outputs)
